_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/
# RStudio project files + per-user session state (never share)
*.Rproj
.Rproj.user/
.Rhistory
.Rapp.history
# NOTE: Gemfile.lock is deliberately COMMITTED, not ignored. This is a site, not
# a theme gem: the lockfile is what makes the GitHub Pages build reproducible and
# is what Dependabot needs in order to propose gem updates at all. Regenerate it
# with ./scripts/update-lockfile.sh, never by hand.
.DS_Store
*.log
# FUSE / editor-sync artifacts left when a file is edited while open. They can
# carry corrupted front matter and must never be committed or built.
.fuse_hidden*
# Backup files left by image tools / editors (e.g. photo.jpg~)
*~
# One-off scratch/preview image exports (never part of the site)
*-tmp.png
*-preview.png
_logocheck.png
node_modules/
.venv/
__pycache__/

# Generated from _site/sitemap.xml by scripts/build_pa11y_config.py at check time.
# Edit pa11y.settings.json instead; this file is rebuilt every run.
pa11yci.generated.json
